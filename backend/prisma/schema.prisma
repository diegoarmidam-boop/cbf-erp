// Esquema V1 — CBF ERP
// Cubre: núcleo (auth/permisos/auditoría/propone-autoriza), Unidades de Producción,
// RH, Nómina, Almacén, Compras, Equipos y Maquinaria, Aplicaciones, Fertilizantes, Riego.
// Fuera de alcance V1 (no modelado aquí): Cosecha, Empaque, Embarques, Contabilidad,
// Auditoría (UI), Panel Ejecutivo — ver docs/spec-snapshot.md secciones 9.8 en adelante.
//
// Decisión de diseño: IDs como UUID (String) en todas las tablas, no autoincrement.
// Motivo: el móvil de campo es offline-first (patrón outbox) y debe poder generar
// un registro localmente, con su ID definitivo, sin depender de una respuesta del
// servidor — necesario desde el día 1 para Nómina (Captura del día) y más adelante
// para Aplicaciones/Fertilizantes/Riego. Mantener un solo esquema de ID en todo el
// sistema evita una migración dolorosa cuando esas tablas lo necesiten.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// NÚCLEO — auth, permisos, auditoría, propone/autoriza
// (Bloques 4 y 6 del documento vivo)
// ============================================================

enum Rol {
  director_general
  encargado_sistemas
  gerente_tecnico_produccion
  asistente_tecnico_produccion
  supervisor_huerta
  ayudante_supervisor
  regador
  gerente_mantenimiento
  mecanico
  supervisor_cosecha
  supervisor_empaque
  encargado_cosecha_empaque
  gerente_logistica
  recursos_humanos
  encargado_nominas
  gerente_administrativo
  contador
  asistente_administrativo
  encargado_compras
  encargado_bodega
  bodeguista
  auditor
  capturista_informacion
}

// Fuente única de permisos por rol × módulo — alimenta sidebar (PC),
// bottom nav y grilla "Más" (móvil). Ningún menú se mantiene a mano (bloque 4).
model PermisoModulo {
  id       String  @id @default(uuid())
  rol      Rol
  modulo   String // slug del módulo, ej. "nomina", "almacen"
  ver      Boolean @default(false)
  capturar Boolean @default(false)
  editar   Boolean @default(false)
  autoriza Boolean @default(false)

  @@unique([rol, modulo])
}

model Usuario {
  id            String    @id @default(uuid())
  nombre        String
  username      String    @unique
  passwordHash  String
  rol           Rol
  personalId    String?   @unique
  personal      Personal? @relation(fields: [personalId], references: [id])
  huertaId      String? // alcance: null = global/multi-rancho; set = restringido a una Huerta
  huerta        Huerta?   @relation(fields: [huertaId], references: [id])
  activo        Boolean   @default(true)
  creadoPorId   String?
  fechaCreacion DateTime  @default(now())

  auditoriaEntradas     AuditoriaLog[]
  solicitudesPropuestas SolicitudPendiente[] @relation("propuestoPor")
  solicitudesResueltas  SolicitudPendiente[] @relation("resueltoPor")

  @@index([rol])
}

// Bitácora genérica de auditoría — capa transversal, no espera al módulo de
// Auditoría (9.17) para existir. Todo módulo que capture/edite debe escribir aquí.
model AuditoriaLog {
  id            String   @id @default(uuid())
  tabla         String
  registroId    String
  accion        String // "crear" | "editar" | "eliminar"
  valorAnterior Json?
  valorNuevo    Json?
  usuarioId     String
  usuario       Usuario  @relation(fields: [usuarioId], references: [id])
  fecha         DateTime @default(now())

  @@index([tabla, registroId])
  @@index([usuarioId])
}

enum EstadoSolicitud {
  pendiente
  autorizada
  rechazada
}

// Mecanismo genérico "Propone / Autoriza" (bloque 4) — reutilizado por:
// actividad nueva/cambio de tarifa, alta de Personal, producto nuevo,
// compra manual, producto para aplicar a planta. El elemento propuesto
// queda bloqueado (no usable) hasta autorizarse.
model SolicitudPendiente {
  id              String          @id @default(uuid())
  tipo            String // ej. "personal_alta", "producto_alta", "actividad_alta", "orden_compra_manual"
  entidadTabla    String // tabla afectada, para poder activarla al autorizar
  entidadId       String? // si el registro ya existe en estado "no usable"
  payload         Json // datos propuestos, usados para crear el registro al autorizar si aún no existe
  estado          EstadoSolicitud @default(pendiente)
  motivoRechazo   String?
  propuestoPorId  String
  propuestoPor    Usuario         @relation("propuestoPor", fields: [propuestoPorId], references: [id])
  fechaPropuesta  DateTime        @default(now())
  resueltoPorId   String?
  resueltoPor     Usuario?        @relation("resueltoPor", fields: [resueltoPorId], references: [id])
  fechaResolucion DateTime?

  @@index([tipo, estado])
}

// ============================================================
// UNIDADES DE PRODUCCIÓN (9.1)
// ============================================================

model Huerta {
  id               String  @id @default(uuid())
  nombre           String  @unique
  hectareasTotales Decimal @db.Decimal(10, 4)
  activo           Boolean @default(true)
  // Croquis/plano ya existente subido como imagen de referencia — capa
  // visual estática, sin vínculo estructurado a Cuadro (9.1).
  mapaUrl          String?

  cuadros                 Cuadro[]
  seccionesRiego          SeccionRiego[]
  usuarios                Usuario[]
  personal                Personal[]
  registrosNomina         RegistroNomina[]
  diasCerrados            DiaCerrado[]
  almacenLocal            AlmacenLocal[]
  actividadesProgramadas  ActividadProgramada[]
  aplicaciones            Aplicacion[]
  fertilizacionesGranular FertilizacionGranular[]
  fertirriegos            FertirriegoProgramacion[]
  equipoUsoDiario         EquipoUsoDiario[]
  analisisLaboratorio     AnalisisLaboratorio[]
  ciclos                  Ciclo[]
}

enum EstatusCuadro {
  activo
  en_descanso
  fuera_produccion
}

model Cuadro {
  id                   String        @id @default(uuid())
  huertaId             String
  huerta               Huerta        @relation(fields: [huertaId], references: [id])
  nombre               String
  estatus              EstatusCuadro @default(activo)
  camposPersonalizados Json?

  versiones                             CuadroVersion[]
  cicloVariedades                       CicloVariedad[]
  seccionRiegoCuadros                   SeccionRiegoCuadro[]
  registrosNomina                       RegistroNomina[]
  actividadProgramadaCuadros            ActividadProgramadaCuadro[]
  actividadRealizadaCuadros             ActividadRealizadaCuadro[]
  aplicacionCuadros                     AplicacionCuadro[]
  fertilizacionGranularCuadros          FertilizacionGranularCuadro[]
  aplicacionRealizadaCuadros            AplicacionRealizadaCuadro[]
  fertilizacionGranularRealizadaCuadros FertilizacionGranularRealizadaCuadro[]

  @@unique([huertaId, nombre])
}

// Historial de configuración por fecha — un Cuadro puede cambiar de superficie
// (recalles, ajuste de calles) o dejar de sembrarse; se necesita saber qué
// versión estaba vigente en cada periodo.
model CuadroVersion {
  id           String    @id @default(uuid())
  cuadroId     String
  cuadro       Cuadro    @relation(fields: [cuadroId], references: [id])
  vigenteDesde DateTime  @db.Date
  vigenteHasta DateTime? @db.Date // null = vigente actualmente
  hectareas    Decimal   @db.Decimal(10, 4)
  tipoSuelo    String?
  fechaSiembra DateTime? @db.Date
  distSurcosM  Decimal?  @db.Decimal(6, 3) // Marco de Plantación: distancia entre surcos (m)
  distPlantasM Decimal?  @db.Decimal(6, 3) // Marco de Plantación: distancia entre plantas (m)

  @@index([cuadroId, vigenteDesde])
}

enum TipoCiclo {
  cultivo
  descanso
  prueba
}

enum EtapaCiclo {
  preparacion_suelo
  desarrollo
  cosecha_empaque
  post_cosecha
}

// El Ciclo vive a nivel Huerta (no por Cuadro) — cuando el primer Cuadro entra
// a Cosecha, toda la Huerta se sincroniza a esa etapa (corrección de fondo 4-ago).
model Ciclo {
  id          String     @id @default(uuid())
  huertaId    String
  huerta      Huerta     @relation(fields: [huertaId], references: [id])
  tipo        TipoCiclo
  etapaActual EtapaCiclo @default(preparacion_suelo)
  fechaInicio DateTime   @db.Date
  fechaFin    DateTime?  @db.Date
  activo      Boolean    @default(true)

  variedades CicloVariedad[]

  @@index([huertaId, activo])
}

// Composición varietal por cuadro dentro del ciclo. La mayoría de cuadros llevan
// una sola fila; cuadros de prueba pueden tener varias. La suma de hectareas por
// cuadroId no puede exceder la superficie vigente del Cuadro (candado en ciclos.ts).
model CicloVariedad {
  id         String   @id @default(uuid())
  cicloId    String
  ciclo      Ciclo    @relation(fields: [cicloId], references: [id])
  cuadroId   String
  cuadro     Cuadro   @relation(fields: [cuadroId], references: [id])
  variedad   String
  hectareas  Decimal? @db.Decimal(10, 4)
  porcentaje Decimal? @db.Decimal(5, 2)

  @@index([cicloId])
  @@index([cuadroId])
}

// Agrupa Cuadros de una Huerta por válvula compartida — independiente de Ciclo/etapa.
model SeccionRiego {
  id       String @id @default(uuid())
  huertaId String
  huerta   Huerta @relation(fields: [huertaId], references: [id])
  nombre   String

  cuadros              SeccionRiegoCuadro[]
  fertirriegoSecciones FertirriegoSeccion[]
  registrosRiego       RiegoRegistroDiario[]

  @@unique([huertaId, nombre])
}

model SeccionRiegoCuadro {
  seccionId String
  seccion   SeccionRiego @relation(fields: [seccionId], references: [id])
  cuadroId  String
  cuadro    Cuadro       @relation(fields: [cuadroId], references: [id])

  @@id([seccionId, cuadroId])
}

// ============================================================
// RECURSOS HUMANOS (9.12)
// ============================================================

enum Periodicidad {
  semanal
  quincenal
  mensual
}

enum MetodoAsignacionCosto {
  directo_huerta
  prorrateo_hectareas
}

model Puesto {
  id                    String                @id @default(uuid())
  nombre                String                @unique
  periodicidad          Periodicidad
  rangoSalarialMin      Decimal?              @db.Decimal(10, 2)
  rangoSalarialMax      Decimal?              @db.Decimal(10, 2)
  metodoAsignacionCosto MetodoAsignacionCosto

  personal Personal[]
}

enum TipoPersonal {
  fijo
  destajo
}

model Personal {
  id                 String       @id @default(uuid())
  nombreCompleto     String
  tipo               TipoPersonal
  fechaNacimiento    DateTime?    @db.Date
  identificacion     String?
  domicilio          String?
  telefono           String?
  telefonoEmergencia String?
  fechaIngreso       DateTime?    @db.Date // null hasta que RH lo capture — el seed inicial (Apéndice A) solo trae nombres
  puestoId           String?
  puesto             Puesto?      @relation(fields: [puestoId], references: [id])
  sueldo             Decimal?     @db.Decimal(10, 2) // solo aplica a tipo=fijo
  rfc                String?
  imssOSeguro        String?
  huertaId           String? // huerta "base" (relevante sobre todo para fijos: supervisor, regador)
  huerta             Huerta?      @relation(fields: [huertaId], references: [id])
  activo             Boolean      @default(true)
  fechaBaja          DateTime?    @db.Date
  motivoBaja         String?
  dadoBajaPorId      String?
  // Liquidación (9.11, 15-ago-2026): distinto de la Baja formal (arriba) —
  // no se toca `activo`/`fechaBaja` aquí, la persona sigue existiendo en el
  // catálogo por si regresa. Solo deja de ofrecerse en Captura del día a
  // partir de esta fecha; se limpia manualmente si vuelve a trabajar.
  noDisponibleDesde  DateTime?    @db.Date

  usuario                    Usuario?
  liquidaciones              Liquidacion[]
  documentos                 PersonalDocumento[]
  grupoMiembros              GrupoMiembro[]
  registrosNomina            RegistroNomina[]
  prestamos                  Prestamo[]
  bonosOtorgados             BonoOtorgado[]
  compromisosEspeciales      CompromisoEspecial[]
  faltasInjustificadas       FaltaInjustificada[]
  equipoUsoDiario            EquipoUsoDiario[]
  grupoAsistenciaDias        GrupoAsistenciaDia[]
  aplicacionLineasOperador   AplicacionRealizadaLinea[]        @relation("AplicacionLineaOperador")
  aplicacionLineaPersonas    AplicacionRealizadaLineaPersona[] @relation("AplicacionLineaPersona")
  equiposComoOperadorDesignado Equipo[]                        @relation("EquipoOperadorDesignado")
  actividadLineasOperador   ActividadRealizadaLinea[]          @relation("ActividadLineaOperador")
  actividadLineaPersonas    ActividadRealizadaLineaPersona[]   @relation("ActividadLineaPersona")

  @@index([tipo, activo])
}

enum TipoDocumentoPersonal {
  identificacion
  contrato
  comprobante_domicilio
  otro
}

enum OrigenDocumento {
  foto_celular
  escaneo
}

model PersonalDocumento {
  id            String                @id @default(uuid())
  personalId    String
  personal      Personal              @relation(fields: [personalId], references: [id])
  tipoDocumento TipoDocumentoPersonal
  archivoUrl    String
  origen        OrigenDocumento
  fechaSubida   DateTime              @default(now())
}

// Administrada por RH, visible para encargados de huerta.
model DoNotHire {
  id                String   @id @default(uuid())
  nombreReferencia  String
  motivo            String
  condicionesSalida String?
  registradoPorId   String
  fecha             DateTime @default(now())
}

// ============================================================
// NÓMINA (9.11, incluye Asistencia)
// ============================================================

enum EsquemaPago {
  individual_hora
  individual_caja
  grupal_remolque
  depende_empacadores
}

// Catálogo de Actividades — compartido con Aplicaciones/Fertilizantes (9.4).
// Arranca con las 12 confirmadas del Apéndice A; el resto se agrega vía
// "+" conforme se autorice (Gerente Administrativo).
// Tipo de recurso (9.4, 15-ago-2026, reabre decisión previa del 11-ago que
// dejaba a Actividades sin maquinaria): determina qué modalidades de línea
// se ofrecen al reportar avance — "gente" solo permite líneas de gente,
// "tractor" solo líneas de tractor, "mixta" permite combinar cualquiera
// (mismo criterio de "no forzar los 3 siempre" del bloque 9.4).
enum TipoRecursoActividad {
  gente
  tractor
  mixta
}

model Actividad {
  id                String               @id @default(uuid())
  nombre            String               @unique
  unidad            String // hora | dia | surco | planta | remolque | caja | cuadro | kg | ha
  tarifa            Decimal              @db.Decimal(10, 2)
  usarTarifaGeneral Boolean              @default(false) // si true, ignora `tarifa` y usa ConfigNomina.tarifaGeneralHora
  esquemaPago       EsquemaPago
  requiereCuadro    Boolean              @default(false) // solo grupal_remolque lo requiere obligatoriamente hoy
  etapaRestringida  EtapaCiclo? // null = libre en cualquier etapa del ciclo
  tipoRecurso       TipoRecursoActividad @default(gente)
  activo            Boolean              @default(true)

  registrosNomina        RegistroNomina[]
  actividadesProgramadas ActividadProgramada[]
}

// Configuración global de Nómina (singleton por clave).
model ConfigNomina {
  clave String @id
  valor String
}

// Switch de comunicación por módulo (bloque de arquitectura, 20-ago-2026):
// herramienta de desarrollo — cuando `comunicacionActiva` es false, el
// backend deja de disparar las cascadas automáticas que salen de ese
// módulo hacia los demás (mano de obra a Nómina, salida de Almacén, uso
// diario de Equipos, auto-orden a Compras, etc.), sin apagar el módulo en
// sí ni borrar nada — el dato correspondiente en el módulo destino queda
// abierto para capturarse a mano con la misma estructura de siempre. Todos
// los módulos tienen su fila desde el arranque (ver seed), aunque hoy solo
// algunos generen cascada. Auditado automáticamente por el extension de
// Prisma en core/db.ts (ver MODELOS_AUDITADOS) — no necesita bitácora
// propia, ya se aprovecha AuditoriaLog.
model ModuloConfig {
  modulo             String  @id
  comunicacionActiva Boolean @default(true)
}

// Cuadrillas — con nombre persistente (reutilizadas semana a semana) o
// armadas el mismo día sin nombre fijo (persistente=false).
// Catálogo global (9.11) — un grupo de pago NO está asociado a ninguna
// Huerta, ni siquiera como referencia opcional: hay cuadrillas (ej. de
// empaque) que se mueven libremente entre Ranchos.
model GrupoPago {
  id          String  @id @default(uuid())
  nombre      String?
  persistente Boolean @default(true)

  miembros        GrupoMiembro[]
  registrosNomina RegistroNomina[]
  asistenciaDias  GrupoAsistenciaDia[]
}

// Quién estaba en el grupo cada día — necesario para dividir el pago del
// remolque entre exactamente quienes subieron ese día.
model GrupoMiembro {
  id         String    @id @default(uuid())
  grupoId    String
  grupo      GrupoPago @relation(fields: [grupoId], references: [id])
  personalId String
  personal   Personal  @relation(fields: [personalId], references: [id])
  fechaDesde DateTime  @db.Date
  fechaHasta DateTime? @db.Date

  @@index([grupoId, fechaDesde])
}

enum TipoAsistenciaGrupoDia {
  ausente
  sustituto
}

// Asistencia dinámica y sustitución dentro de un Grupo de Pago (9.11):
// checklist editable SOLO para ese día — quien falta o sustituye ese día
// específico, sin tocar todavía el roster fijo (GrupoMiembro). La regla de
// "se vuelve fijo"/"sale del roster" a los 3 días seguidos se calcula a
// partir de estos registros, y ahí sí modifica GrupoMiembro.
model GrupoAsistenciaDia {
  id              String                 @id @default(uuid())
  grupoId         String
  grupo           GrupoPago              @relation(fields: [grupoId], references: [id])
  fecha           DateTime               @db.Date
  personalId      String
  personal        Personal               @relation(fields: [personalId], references: [id])
  tipo            TipoAsistenciaGrupoDia
  registradoPorId String

  @@unique([grupoId, fecha, personalId])
  @@index([grupoId, fecha])
}

enum OrigenRegistroNomina {
  manual
  automatico_aplicacion
  automatico_fertilizacion
  automatico_actividad
  automatico_cosecha
  automatico_empaque
}

// Registro fuente de mano de obra — cada fila es una persona (o grupo) +
// actividad + cantidad en un día/huerta. Alimenta el caso de uso ancla:
// las capturas automáticas (Aplicaciones/Fertilizantes) escriben aquí con
// `origen` distinto de "manual" y una referencia al registro que lo generó.
model RegistroNomina {
  id                 String               @id @default(uuid())
  fecha              DateTime             @db.Date
  huertaId           String
  huerta             Huerta               @relation(fields: [huertaId], references: [id])
  cuadroId           String?
  cuadro             Cuadro?              @relation(fields: [cuadroId], references: [id])
  personalId         String?
  personal           Personal?            @relation(fields: [personalId], references: [id])
  grupoId            String?
  grupo              GrupoPago?           @relation(fields: [grupoId], references: [id])
  actividadId        String
  actividad          Actividad            @relation(fields: [actividadId], references: [id])
  cantidad           Decimal              @db.Decimal(10, 3)
  tarifaAplicada     Decimal              @db.Decimal(10, 2) // congelada al momento de captura
  origen             OrigenRegistroNomina @default(manual)
  referenciaOrigenId String?
  capturadoPorId     String
  fechaCaptura       DateTime             @default(now())

  @@index([huertaId, fecha])
  @@index([personalId, fecha])
  @@index([grupoId, fecha])
}

// Cierre diario por Huerta — bloquea ediciones posteriores. Distinto del
// cierre de periodo contable (mensual/anual, solo Contabilidad).
model DiaCerrado {
  huertaId     String
  huerta       Huerta   @relation(fields: [huertaId], references: [id])
  fecha        DateTime @db.Date
  cerradoPorId String
  fechaCierre  DateTime @default(now())

  @@id([huertaId, fecha])
}

model Prestamo {
  id                   String       @id @default(uuid())
  personalId           String
  personal             Personal     @relation(fields: [personalId], references: [id])
  montoTotal           Decimal      @db.Decimal(10, 2)
  motivo               String
  periodicidad         Periodicidad // solo semanal|quincenal aplican aquí
  montoPorDescuento    Decimal      @db.Decimal(10, 2)
  fechaPrimerDescuento DateTime     @db.Date
  proximoDescuento     DateTime     @db.Date // avanza cada vez que se aplica un descuento; empieza igual a fechaPrimerDescuento
  saldoPendiente       Decimal      @db.Decimal(10, 2)
  activo               Boolean      @default(true)

  descuentos PrestamoDescuento[]

  @@index([personalId, activo])
}

model PrestamoDescuento {
  id            String   @id @default(uuid())
  prestamoId    String
  prestamo      Prestamo @relation(fields: [prestamoId], references: [id])
  periodoFin    DateTime @db.Date // fin del periodo semanal de nómina en que se aplicó
  monto         Decimal  @db.Decimal(10, 2)
  fechaAplicado DateTime @default(now())
  aplicadoPorId String
}

// Liquidación fuera de ciclo (9.11, 15-ago-2026, feature nueva): pagar a
// alguien eventual/destajo que deja de venir a mitad del periodo semanal
// normal — no toca Nómina fija ni al Grupo de Pago de la persona. El rango
// [fechaInicio, fechaFin] es el que se liquida (default: día siguiente al
// último cierre de Nómina a nivel empresa → último día trabajado).
model Liquidacion {
  id                    String   @id @default(uuid())
  personalId            String
  personal              Personal @relation(fields: [personalId], references: [id])
  fechaInicio           DateTime @db.Date
  fechaFin              DateTime @db.Date
  bruto                 Decimal  @db.Decimal(10, 2)
  bonos                 Decimal  @db.Decimal(10, 2)
  descuentoPrestamos    Decimal  @db.Decimal(10, 2) // 0 si no se confirmó descontar — nunca automático, ver liquidaciones.ts
  neto                  Decimal  @db.Decimal(10, 2)
  liquidadoPorId        String
  fechaLiquidacion      DateTime @default(now())

  @@index([personalId])
}

enum TipoBono {
  asistencia_perfecta
  permanencia_racha
  dia_doble
}

// 3 plantillas configurables sin tocar código.
model BonoConfig {
  id         String   @id @default(uuid())
  tipo       TipoBono
  nombre     String
  parametros Json // monto fijo, multiplicador, días requeridos, etc. según tipo
  activo     Boolean  @default(true)

  diasEspeciales BonoDiaEspecial[]
  otorgados      BonoOtorgado[]
}

// Fechas específicas para bonos tipo "día doble" (ej. domingos, festivos definidos por RH).
model BonoDiaEspecial {
  id     String     @id @default(uuid())
  bonoId String
  bono   BonoConfig @relation(fields: [bonoId], references: [id])
  fecha  DateTime   @db.Date
}

// Si se ofrece un día extra y la persona acepta pero no se presenta, rompe
// la racha de asistencia perfecta aunque haya cumplido sus días normales.
model CompromisoEspecial {
  id          String   @id @default(uuid())
  personalId  String
  personal    Personal @relation(fields: [personalId], references: [id])
  fecha       DateTime @db.Date
  descripcion String
  cumplido    Boolean?

  @@index([personalId, fecha])
}

// Solo aplica a personal fijo: "se asume presente salvo que pidan
// vacaciones/descanso" (9.11), así que una falta es un hecho que alguien
// debe registrar explícitamente — distinto de "sin registro todavía" (gris
// en la tira de asistencia), que es la ausencia de esta fila, no una fila.
// Por ahora solo se registra para consulta; el sistema queda preparado para
// activar el descuento automático más adelante, sin activarlo todavía.
model FaltaInjustificada {
  id              String   @id @default(uuid())
  personalId      String
  personal        Personal @relation(fields: [personalId], references: [id])
  fecha           DateTime @db.Date
  notas           String?
  registradoPorId String
  fechaRegistro   DateTime @default(now())

  @@unique([personalId, fecha])
}

enum EstadoBono {
  pendiente_autorizar
  autorizado
  rechazado
}

model BonoOtorgado {
  id              String     @id @default(uuid())
  bonoConfigId    String
  bonoConfig      BonoConfig @relation(fields: [bonoConfigId], references: [id])
  personalId      String
  personal        Personal   @relation(fields: [personalId], references: [id])
  periodoInicio   DateTime   @db.Date
  periodoFin      DateTime   @db.Date
  montoCalculado  Decimal    @db.Decimal(10, 2)
  estado          EstadoBono @default(pendiente_autorizar)
  autorizadoPorId String?

  @@index([personalId, periodoFin])
}

// ============================================================
// EQUIPOS Y MAQUINARIA (9.13, incluye Combustibles y Mantenimiento)
// ============================================================

enum TipoEquipo {
  tractor
  camioneta
  remolque
  implemento
}

model Equipo {
  id     String     @id @default(uuid())
  tipo   TipoEquipo
  folio  String     @unique // AF-xxx (tractor/camioneta/remolque) o IA-xxx (implemento)
  marca  String?
  modelo String?
  anio   Int?
  placas String?
  activo Boolean    @default(true)

  // Operador designado (9.13, 15-ago-2026): opcional porque camionetas y
  // equipo grande casi siempre tienen operador fijo, pero tractores
  // pequeños no necesariamente (varía, sobre todo en cosecha). Solo
  // precarga el default en las pantallas de captura — editable ahí sin
  // afectar este valor guardado.
  operadorDesignadoId String?
  operadorDesignado   Personal? @relation("EquipoOperadorDesignado", fields: [operadorDesignadoId], references: [id])

  cargasCombustible          CombustibleCarga[]
  mantenimientoConceptos     MantenimientoConcepto[]
  mantenimientoEventos       MantenimientoEvento[]
  usoDiario                  EquipoUsoDiario[]
  fertilizacionesGranular    FertilizacionGranular[]
  aplicacionLineasTractor    AplicacionRealizadaLinea[] @relation("AplicacionLineaTractor")
  aplicacionLineasImplemento AplicacionRealizadaLinea[] @relation("AplicacionLineaImplemento")
  actividadLineasTractor     ActividadRealizadaLinea[]  @relation("ActividadLineaTractor")
  actividadLineasImplemento  ActividadRealizadaLinea[]  @relation("ActividadLineaImplemento")
}

enum TipoCombustible {
  diesel_garrafa // tractores — sale del Almacén como insumo
  gasolina_externa // camionetas — gasolinera externa, no consume Almacén
  diesel_externo // camionetas a diésel que cargan directo en gasolinera
}

model CombustibleCarga {
  id             String          @id @default(uuid())
  equipoId       String
  equipo         Equipo          @relation(fields: [equipoId], references: [id])
  fecha          DateTime        @db.Date
  tipo           TipoCombustible
  odometro       Decimal?        @db.Decimal(10, 1) // camionetas
  horometro      Decimal?        @db.Decimal(10, 1) // tractores
  litros         Decimal         @db.Decimal(10, 2)
  precioUnitario Decimal?        @db.Decimal(10, 2) // camionetas
  capturadoPorId String

  @@index([equipoId, fecha])
}

model MantenimientoConcepto {
  id          String  @id @default(uuid())
  equipoId    String
  equipo      Equipo  @relation(fields: [equipoId], references: [id])
  nombre      String // ej. "Filtro de diésel"
  umbralHoras Decimal @db.Decimal(10, 1)

  eventos MantenimientoEvento[]
}

enum TipoMantenimiento {
  preventivo
  correctivo
}

model MantenimientoEvento {
  id              String                 @id @default(uuid())
  equipoId        String
  equipo          Equipo                 @relation(fields: [equipoId], references: [id])
  tipo            TipoMantenimiento
  conceptoId      String?
  concepto        MantenimientoConcepto? @relation(fields: [conceptoId], references: [id])
  descripcion     String
  mecanicoInterno Boolean
  costo           Decimal?               @db.Decimal(10, 2)
  fecha           DateTime               @db.Date

  @@index([equipoId, fecha])
}

enum OrigenUsoDiario {
  manual
  automatico_aplicacion
  automatico_actividad
}

// Alimentación automática desde Aplicaciones (9.7/9.13, 8-ago-2026): cada
// línea de Turbina/Aguilón de un reporte de avance reporta aquí también,
// para no capturar el uso del tractor dos veces por separado.
// `referenciaLineaId` (AplicacionRealizadaLinea.id) hace esto idempotente y
// trazable — igual que `referenciaOrigenId` en RegistroNomina.
model EquipoUsoDiario {
  id                String          @id @default(uuid())
  equipoId          String
  equipo            Equipo          @relation(fields: [equipoId], references: [id])
  fecha             DateTime        @db.Date
  operadorId        String
  operador          Personal        @relation(fields: [operadorId], references: [id])
  horas             Decimal         @db.Decimal(6, 2)
  huertaId          String
  huerta            Huerta          @relation(fields: [huertaId], references: [id])
  origen            OrigenUsoDiario @default(manual)
  referenciaLineaId String?

  @@index([equipoId, fecha])
  @@index([referenciaLineaId])
}

// ============================================================
// ALMACÉN (9.15, incluye Almacén Local por Unidad de Producción)
// ============================================================

// Catálogos abiertos (patrón "+" agregar) que alimentan los selects de alta
// de Producto. `categoria` e `ingredienteActivo` en Producto se guardan como
// texto plano (así los sigue leyendo la lógica de FIFO/regulación existente);
// estos catálogos solo respaldan el dropdown y permiten agregar valores.
model CategoriaProducto {
  id     String  @id @default(uuid())
  nombre String  @unique
  activo Boolean @default(true)
}

model IngredienteActivo {
  id     String  @id @default(uuid())
  nombre String  @unique
  activo Boolean @default(true)

  // Producto preferido y sustitutos autorizados (9.15, 20-ago-2026): a
  // nivel empresa, no por Huerta. No cambia el FIFO de consumo (eso sigue
  // siendo por antigüedad dentro del mismo Ingrediente Activo) — esto solo
  // homologa qué se compra cuando el preferido no está disponible con el
  // proveedor. Solo Director General/Gerente Técnico de Producción lo
  // administran (mismo permiso "almacen_regulado"/autoriza que ya existe
  // para autorizar productos).
  productoPreferidoId String?
  productoPreferido   Producto?                    @relation("ProductoPreferidoDe", fields: [productoPreferidoId], references: [id])
  sustitutos          IngredienteActivoSustituto[]
}

// Lista ordenada por prioridad — `orden` bajo = se prueba primero cuando el
// preferido no está disponible. Solo se autoriza un sustituto si tiene la
// misma dosificación que el preferido (regla de negocio, no validada por
// código — no hay conversión de dosis en Aplicaciones/Fertilizantes).
model IngredienteActivoSustituto {
  id                  String            @id @default(uuid())
  ingredienteActivoId String
  ingredienteActivo   IngredienteActivo @relation(fields: [ingredienteActivoId], references: [id], onDelete: Cascade)
  productoId          String
  producto            Producto          @relation("ProductoSustitutoDe", fields: [productoId], references: [id])
  orden               Int

  @@unique([ingredienteActivoId, productoId])
  @@index([ingredienteActivoId])
}

model Contenedor {
  id     String  @id @default(uuid())
  nombre String  @unique
  activo Boolean @default(true)
}

model Producto {
  id                   String    @id @default(uuid())
  categoria            String // agroquimico | fertilizante | refaccion | general | ...
  ingredienteActivo    String?
  nombreComercial      String
  contenedor           String // catálogo abierto (Saco/Bote/Garrafa/Tanque/Bolsa/...)
  presentacionCantidad Decimal   @db.Decimal(10, 3)
  unidad               String
  requiereLote         Boolean   @default(false) // agroquímicos/fertilizantes: true; Almacén General: false
  autorizado           Boolean   @default(false) // agroquímico/fertilizante deben autorizarse antes de comprarse/aplicarse
  autorizadoPorId      String?
  fechaAutorizacion    DateTime?
  activo               Boolean   @default(true) // desactivar en vez de borrar — hay lotes/movimientos/historial ligados

  lotes                          ProductoLote[]
  movimientosCentral             AlmacenCentralMovimiento[]
  almacenLocal                   AlmacenLocal[]
  ordenesCompra                  OrdenCompra[]
  aplicacionProductos            AplicacionProducto[]
  fertilizacionGranularProductos FertilizacionGranularProducto[]
  fertirriegoProductos           FertirriegoProgramacionProducto[]
  riegoRegistroDiarioProductos   RiegoRegistroDiarioProducto[]
  comparacionItems               ComparacionItem[]
  preferidoDe                    IngredienteActivo[]              @relation("ProductoPreferidoDe")
  sustitutoDe                    IngredienteActivoSustituto[]      @relation("ProductoSustitutoDe")
  recetaProductos                RecetaProducto[]

  @@index([categoria])
}

model ProductoLote {
  id             String    @id @default(uuid())
  productoId     String
  producto       Producto  @relation(fields: [productoId], references: [id])
  lote           String
  fechaCaducidad DateTime? @db.Date
  cantidadActual Decimal   @db.Decimal(12, 3)

  movimientos AlmacenCentralMovimiento[]

  @@index([productoId])
}

enum TipoMovimientoAlmacenCentral {
  entrada_compra
  salida_comprometida
  salida_real
  prestamo_rancho
  merma
  baja_caducidad
  abono_sobrante
  ajuste_manual
  consumo_maquinaria // diésel de garrafa consumido por un tractor — es inventario, igual que un agroquímico (9.13)
}

// FIFO obligatorio por ingrediente activo. Salidas quedan "comprometidas" al
// planear una Aplicación/Fertilización, y se vuelven "salida_real" al
// entregarse físicamente a la Huerta (ver Aplicaciones/Fertilizantes).
model AlmacenCentralMovimiento {
  id              String                       @id @default(uuid())
  productoId      String
  producto        Producto                     @relation(fields: [productoId], references: [id])
  loteId          String?
  lote            ProductoLote?                @relation(fields: [loteId], references: [id])
  tipo            TipoMovimientoAlmacenCentral
  cantidad        Decimal                      @db.Decimal(12, 3)
  huertaDestinoId String?
  referenciaId    String? // aplicacionId / fertilizacionId / ordenCompraId, según el tipo
  fecha           DateTime                     @default(now())
  capturadoPorId  String
  motivoAjuste    String? // requerido para merma/ajuste_manual (doble-check de Gerencia)
  // Firma digital de recepción de Bodega, por movimiento (15-ago-2026):
  // permite confirmar cada devolución de sobrante por separado — a
  // diferencia de Aplicacion.confirmacionBodegaPorId (un solo campo, para
  // la cancelación completa), un ajuste de dosis puede repetirse varias
  // veces sobre la misma Aplicación/Fertilización. Default true para que
  // ningún abono histórico (previo a este campo) aparezca como pendiente.
  confirmado      Boolean                      @default(true)
  confirmadoPorId String?
  fechaConfirmado DateTime?

  @@index([productoId, fecha])
  @@index([huertaDestinoId])
}

// Saldo simple por Huerta y producto — sin lotes/caducidad ("le mandaron 100 L,
// lleva reportados 60 L, le quedan 40 L").
model AlmacenLocal {
  id                         String   @id @default(uuid())
  huertaId                   String
  huerta                     Huerta   @relation(fields: [huertaId], references: [id])
  productoId                 String
  producto                   Producto @relation(fields: [productoId], references: [id])
  cantidadRecibidaAcumulada  Decimal  @default(0) @db.Decimal(12, 3)
  cantidadReportadaAcumulada Decimal  @default(0) @db.Decimal(12, 3)

  movimientos AlmacenLocalMovimiento[]

  @@unique([huertaId, productoId])
}

enum TipoMovimientoAlmacenLocal {
  entrega
  consumo_reportado
  ajuste_manual
}

model AlmacenLocalMovimiento {
  id             String                     @id @default(uuid())
  almacenLocalId String
  almacenLocal   AlmacenLocal               @relation(fields: [almacenLocalId], references: [id])
  tipo           TipoMovimientoAlmacenLocal
  cantidad       Decimal                    @db.Decimal(12, 3)
  referenciaId   String? // aplicacionRealizadaId / fertilizacionRealizadaId / riegoRegistroId
  fecha          DateTime                   @default(now())
  capturadoPorId String

  @@index([almacenLocalId, fecha])
}

// ============================================================
// COMPRAS (9.14, incluye Proveedores)
// ============================================================

model Proveedor {
  id                 String    @id @default(uuid())
  nombre             String
  creditoMonto       Decimal?  @db.Decimal(12, 2)
  creditoVencimiento DateTime? @db.Date
  diasCredito        Int? // término general de pago (ej. "15 días de crédito") — alimenta Cuentas por Pagar (9.14)
  datosFacturacion   Json?
  activo             Boolean   @default(true)

  ordenesCompra           OrdenCompra[]
  comparacionCotizaciones ComparacionCotizacion[]
}

enum OrigenOrdenCompra {
  automatica
  manual
}

enum EstadoOrdenCompra {
  pendiente_autorizar // solo manuales
  pendiente_cotizar
  generada // "en camino"
  recibida
  rechazada
}

model OrdenCompra {
  id                     String            @id @default(uuid())
  origen                 OrigenOrdenCompra
  productoId             String
  producto               Producto          @relation(fields: [productoId], references: [id])
  cantidadSolicitada     Decimal           @db.Decimal(12, 3)
  estado                 EstadoOrdenCompra
  proveedorId            String?
  proveedor              Proveedor?        @relation(fields: [proveedorId], references: [id])
  precioUnitario         Decimal?          @db.Decimal(10, 2)
  fechaEsperada          DateTime?         @db.Date
  referenciaAplicacionId String? // liga a Aplicacion/FertilizacionGranular/Fertirriego que la generó
  autorizadoPorId        String?
  motivoRechazo          String?
  creadoPorId            String
  fechaCreacion          DateTime          @default(now())
  fechaFormalizacion     DateTime? // fecha de "Cotizar" (se vuelve "generada") — base del cálculo de CxP
  pagada                 Boolean           @default(false)
  fechaPago              DateTime?

  recepciones OrdenCompraRecepcion[]

  @@index([estado])
}

model OrdenCompraRecepcion {
  id               String      @id @default(uuid())
  ordenId          String
  orden            OrdenCompra @relation(fields: [ordenId], references: [id])
  cantidadRecibida Decimal     @db.Decimal(12, 3)
  lote             String?
  fechaCaducidad   DateTime?   @db.Date
  fechaRecepcion   DateTime    @default(now())
  recibidoPorId    String
}

// Submódulo Comparador de Cotizaciones (9.14): herramienta aparte, no genera
// órdenes — solo ayuda a decidir a qué proveedor comprarle antes de cotizar
// formalmente. Se guarda para poder retomarla/consultarla después.
model Comparacion {
  id            String            @id @default(uuid())
  nombre        String?
  creadoPorId   String
  fechaCreacion DateTime          @default(now())
  items         ComparacionItem[]
}

model ComparacionItem {
  id                String                  @id @default(uuid())
  comparacionId     String
  comparacion       Comparacion             @relation(fields: [comparacionId], references: [id])
  productoId        String
  producto          Producto                @relation(fields: [productoId], references: [id])
  cantidadNecesaria Decimal                 @db.Decimal(12, 3)
  unidad            String
  cotizaciones      ComparacionCotizacion[]

  @@index([comparacionId])
}

model ComparacionCotizacion {
  id                   String          @id @default(uuid())
  itemId               String
  item                 ComparacionItem @relation(fields: [itemId], references: [id])
  proveedorId          String
  proveedor            Proveedor       @relation(fields: [proveedorId], references: [id])
  precioPresentacion   Decimal         @db.Decimal(10, 2)
  cantidadPresentacion Decimal         @db.Decimal(10, 3)
  unidadPresentacion   String

  @@index([itemId])
}

// ============================================================
// ACTIVIDADES (9.4) — mismo patrón de dos pasos que Aplicaciones, sin
// insumo ni maquinaria: alcance inicial de puro mano de obra (Bodega,
// Ahoyado, Siembra, Vivero, Chapeo, Tirar Cinta, Limpieza), confirmado
// 10-ago-2026. Reutiliza el catálogo `Actividad` ya existente (9.2/9.11).
// ============================================================

// Paso 1, Programar (9.4): Huerta, Cuadro(s), actividad del catálogo, rango
// de fechas — sin gate de Almacén (no hay insumo que entregar), así que se
// puede reportar avance desde que se programa, sin paso de "entrega".
model ActividadProgramada {
  id                          String    @id @default(uuid())
  huertaId                    String
  huerta                      Huerta    @relation(fields: [huertaId], references: [id])
  actividadId                 String
  actividad                   Actividad @relation(fields: [actividadId], references: [id])
  fechaInicio                 DateTime  @db.Date
  fechaFin                    DateTime  @db.Date
  hectareasTotalesProgramadas Decimal   @db.Decimal(10, 4)
  creadoPorId                 String
  fechaCreacion               DateTime  @default(now())

  cuadros    ActividadProgramadaCuadro[]
  realizadas ActividadRealizada[]
}

model ActividadProgramadaCuadro {
  actividadProgramadaId String
  actividadProgramada   ActividadProgramada @relation(fields: [actividadProgramadaId], references: [id])
  cuadroId              String
  cuadro                Cuadro              @relation(fields: [cuadroId], references: [id])

  @@id([actividadProgramadaId, cuadroId])
}

// Paso 2, Registrar avance (9.4): por reporte, Cuadro(s) trabajados con
// hectáreas avanzadas de cada uno (candado de suma acumulada por Cuadro,
// igual que Aplicaciones) + personas con sus horas — genera mano de obra
// automática en Nómina (origen=automatico_actividad). Sin líneas de
// maquinaria: ninguna de las 7 actividades del alcance inicial la necesita.
model ActividadRealizada {
  id                    String              @id @default(uuid())
  actividadProgramadaId String
  actividadProgramada   ActividadProgramada @relation(fields: [actividadProgramadaId], references: [id])
  fechaReal             DateTime            @db.Date
  registradoPorId       String

  cuadros ActividadRealizadaCuadro[]
  lineas  ActividadRealizadaLinea[]

  @@index([actividadProgramadaId])
}

// Recurso real usado por reporte (9.4, 15-ago-2026): una o varias líneas,
// cada una con su propio tipo — igual que Aplicaciones (9.7), pero a
// diferencia de esa, las horas se capturan por persona (ver
// ActividadRealizadaLineaPersona.horas), no compartidas por línea —
// confirmado con Diego para no perder la flexibilidad que ya tenía
// Actividades de que cada quien trabaje horas distintas el mismo reporte.
model ActividadRealizadaLinea {
  id            String                  @id @default(uuid())
  realizadaId   String
  realizada     ActividadRealizada      @relation(fields: [realizadaId], references: [id])
  tipo          TipoRecursoActividad
  tractorId     String?
  tractor       Equipo?                 @relation("ActividadLineaTractor", fields: [tractorId], references: [id])
  operadorId    String?
  operador      Personal?               @relation("ActividadLineaOperador", fields: [operadorId], references: [id])
  operadorHoras Decimal?                @db.Decimal(6, 2) // solo si tipo=tractor/mixta
  implementoId  String?
  implemento    Equipo?                 @relation("ActividadLineaImplemento", fields: [implementoId], references: [id])

  personas ActividadRealizadaLineaPersona[]

  @@index([realizadaId])
}

// Personas de una línea con su propia hora individual — para tipo "gente"
// (todas), y para "mixta" (el grupo detrás del tractor, aparte del operador).
model ActividadRealizadaLineaPersona {
  lineaId    String
  linea      ActividadRealizadaLinea @relation(fields: [lineaId], references: [id])
  personalId String
  personal   Personal                @relation("ActividadLineaPersona", fields: [personalId], references: [id])
  horas      Decimal                 @db.Decimal(6, 2)

  @@id([lineaId, personalId])
}

model ActividadRealizadaCuadro {
  id          String             @id @default(uuid())
  realizadaId String
  realizada   ActividadRealizada @relation(fields: [realizadaId], references: [id])
  cuadroId    String
  cuadro      Cuadro             @relation(fields: [cuadroId], references: [id])
  hectareas   Decimal            @db.Decimal(10, 4)

  @@index([realizadaId])
  @@index([cuadroId])
}

// ============================================================
// APLICACIONES — agroquímicos (9.7)
// ============================================================

enum RecursoTipo {
  gente
  implemento
}

// Modalidad real de ejecución de una Aplicación (9.7, corrección 8-ago-2026)
// — reemplaza el recurso fijo "Con gente/Con implemento" de Paso 1, que
// ahora solo es una sugerencia (`Aplicacion.recursoSugerido`). El detalle
// real se captura por línea dentro de cada reporte de avance (Paso 2, ver
// `AplicacionRealizadaLinea`) y puede combinarse/variar del plan original.
// Exclusivo de Aplicaciones — Fertilización Granular (9.5) conserva
// `RecursoTipo` sin cambios, el documento no extendió esta corrección ahí.
enum ModalidadAplicacion {
  mochila
  turbina
  aguilon
}

enum ConcentracionUnidad {
  ml_l
  g_l
  kg_l
}

enum EstadoAplicacion {
  programada
  entregada
  realizada
  vencida
  cancelada
}

// Recetario (20-ago-2026): paquetes técnicos precargados de Aplicaciones y
// Fertirriego — capa adicional sobre la forma libre de programar por
// Ingrediente Activo, que se mantiene exactamente igual sin receta.
// `modulo` evita que una receta de Aplicaciones aparezca en el selector de
// Fertirriego y viceversa — sus catálogos de producto no son intercambiables
// (agroquímicos vs. fertilizantes).
enum ModuloReceta {
  aplicaciones
  fertirriego
}

// Catálogo abierto (botón "+", mismo patrón que Categoría/Ingrediente
// Activo/Contenedor) — foliar, al suelo, preventiva, correctiva, etc.
model TipoAplicacion {
  id     String  @id @default(uuid())
  nombre String  @unique
  activo Boolean @default(true)

  recetas Receta[]
}

model Receta {
  id               String          @id @default(uuid())
  nombre           String
  modulo           ModuloReceta
  tipoAplicacionId String?
  tipoAplicacion   TipoAplicacion? @relation(fields: [tipoAplicacionId], references: [id])
  // Litros de mezcla(o agua)/ha compartido por todos los productos de la
  // receta — misma estructura que ya existe en Aplicacion/
  // FertirriegoProgramacion (un solo tanque, una sola densidad).
  litrosPorHa      Decimal         @db.Decimal(10, 4)
  activo           Boolean         @default(true)
  creadoPorId      String
  fechaCreacion    DateTime        @default(now())

  productos    RecetaProducto[]
  aplicaciones Aplicacion[]
  fertirriegos FertirriegoProgramacion[]
}

model RecetaProducto {
  id                  String              @id @default(uuid())
  recetaId            String
  receta              Receta              @relation(fields: [recetaId], references: [id], onDelete: Cascade)
  productoId          String
  producto            Producto            @relation(fields: [productoId], references: [id])
  concentracionValor  Decimal             @db.Decimal(10, 4)
  concentracionUnidad ConcentracionUnidad

  @@index([recetaId])
}

model Aplicacion {
  id                          String              @id @default(uuid())
  huertaId                    String
  huerta                      Huerta              @relation(fields: [huertaId], references: [id])
  recursoSugerido             ModalidadAplicacion // referencia de cómo se planea hacer — no fija, ver ModalidadAplicacion
  // Litros de mezcla/ha compartidos por todos los productos de esta
  // Aplicación (10-ago-2026, varios productos en el mismo tanque) — un solo
  // tanque, una sola densidad para toda la mezcla. Cada producto conserva
  // su propia concentración/cantidad, ver AplicacionProducto.
  litrosMezclaPorHa           Decimal             @db.Decimal(10, 4)
  // Recetario (20-ago-2026): referencia de trazabilidad a la receta usada
  // como base — nulo si se programó libre por Ingrediente Activo, como
  // siempre. La dosis realmente aplicada vive en AplicacionProducto (puede
  // diferir de la receta si se ajustó "solo por esta vez").
  recetaId                    String?
  receta                      Receta?             @relation(fields: [recetaId], references: [id])
  // Capacidad del tanque/recipiente usado ese día (20-ago-2026) — se
  // captura cada vez que se programa, nunca un catálogo fijo (varía según
  // qué tanque/turbina esté disponible). Nula si no se usó el cálculo de
  // mezcla por tanque.
  capacidadTanque             Decimal?            @db.Decimal(10, 2)
  fechaInicio                 DateTime            @db.Date
  fechaFin                    DateTime            @db.Date
  hectareasTotalesProgramadas Decimal             @db.Decimal(10, 4) // base estable del % de avance y del descuento proporcional — fija desde Paso 1, no recalculada si el Cuadro cambia de superficie después
  estado                      EstadoAplicacion    @default(programada)
  creadoPorId                 String
  fechaCreacion               DateTime            @default(now())
  canceladaPorId              String? // protocolo de cancelación de aplicación entregada y vencida a 15 días (9.7) — Director/Gerente Técnico
  fechaCancelacion            DateTime?
  confirmacionBodegaPorId     String? // firma digital de recepción del Encargado de Bodega — no bloquea el ajuste de inventario, que ya ocurrió al cancelar
  fechaConfirmacionBodega     DateTime?

  productos  AplicacionProducto[]
  cuadros    AplicacionCuadro[]
  realizadas AplicacionRealizada[]
}

// Varios productos en la misma Aplicación (10-ago-2026, 9.7): cada uno se
// autoriza, aparta y descuenta del Almacén por separado, aunque se
// programen y apliquen juntos en el mismo tanque (litrosMezclaPorHa vive en
// Aplicacion, compartido) — cada producto conserva su propia concentración.
model AplicacionProducto {
  id                     String              @id @default(uuid())
  aplicacionId           String
  aplicacion             Aplicacion          @relation(fields: [aplicacionId], references: [id])
  productoId             String
  producto               Producto            @relation(fields: [productoId], references: [id])
  concentracionValor     Decimal             @db.Decimal(10, 4)
  concentracionUnidad    ConcentracionUnidad
  cantidadTotalCalculada Decimal             @db.Decimal(12, 4)

  @@index([aplicacionId])
  @@index([productoId])
}

model AplicacionCuadro {
  aplicacionId String
  aplicacion   Aplicacion @relation(fields: [aplicacionId], references: [id])
  cuadroId     String
  cuadro       Cuadro     @relation(fields: [cuadroId], references: [id])

  @@id([aplicacionId, cuadroId])
}

// Solo puede existir después de que Almacén entregó el producto a la Huerta.
// Genera mano de obra en Nómina (origen=automatico_aplicacion) y descuenta
// el Almacén Local proporcionalmente a las hectáreas avanzadas en ESTE
// reporte. Quién/cómo se hizo vive por línea (ver AplicacionRealizadaLinea,
// corrección 8-ago-2026) — un mismo reporte puede combinar varias líneas
// (ej. una cuadrilla con Mochila y otra con Aguilón el mismo día).
model AplicacionRealizada {
  id              String     @id @default(uuid())
  aplicacionId    String
  aplicacion      Aplicacion @relation(fields: [aplicacionId], references: [id])
  fechaReal       DateTime   @db.Date
  registradoPorId String

  cuadros AplicacionRealizadaCuadro[]
  lineas  AplicacionRealizadaLinea[]

  @@index([aplicacionId])
}

// Cuadro(s) trabajados y hectáreas avanzadas en un reporte específico — un
// mismo Cuadro puede aparecer en varios reportes distintos (avance parcial).
model AplicacionRealizadaCuadro {
  id          String              @id @default(uuid())
  realizadaId String
  realizada   AplicacionRealizada @relation(fields: [realizadaId], references: [id])
  cuadroId    String
  cuadro      Cuadro              @relation(fields: [cuadroId], references: [id])
  hectareas   Decimal             @db.Decimal(10, 4)

  @@index([realizadaId])
  @@index([cuadroId])
}

// Recurso real usado dentro de un reporte de avance (9.7, 8-ago-2026): cada
// línea es una de las 3 modalidades fijas. Turbina/Aguilón requieren
// Tractor+Operador+Implemento; Aguilón además lleva su propia lista de
// personas detrás (no compartida entre líneas); Mochila solo lleva lista de
// personas, sin tractor/implemento. Alimenta automático "Uso diario"
// (Equipos, 9.13) para líneas con Tractor/Operador.
model AplicacionRealizadaLinea {
  id           String              @id @default(uuid())
  realizadaId  String
  realizada    AplicacionRealizada @relation(fields: [realizadaId], references: [id])
  modalidad    ModalidadAplicacion
  tractorId    String?
  tractor      Equipo?             @relation("AplicacionLineaTractor", fields: [tractorId], references: [id])
  operadorId   String?
  operador     Personal?           @relation("AplicacionLineaOperador", fields: [operadorId], references: [id])
  implementoId String?
  implemento   Equipo?             @relation("AplicacionLineaImplemento", fields: [implementoId], references: [id])
  horas        Decimal             @db.Decimal(6, 2)

  personas AplicacionRealizadaLineaPersona[]

  @@index([realizadaId])
}

// Lista de personas de una línea específica — para Mochila (todas), y para
// Aguilón (el grupo detrás del tractor, aparte del operador).
model AplicacionRealizadaLineaPersona {
  lineaId    String
  linea      AplicacionRealizadaLinea @relation(fields: [lineaId], references: [id])
  personalId String
  personal   Personal                 @relation("AplicacionLineaPersona", fields: [personalId], references: [id])

  @@id([lineaId, personalId])
}

// ============================================================
// FERTILIZANTES — Granular y Fertirriego (9.5)
// ============================================================

enum ModoDosisGranular {
  kg_ha
  g_planta
}

// Mismo patrón de dos pasos que Aplicaciones (Programar → Registrar realizada).
model FertilizacionGranular {
  id                          String           @id @default(uuid())
  huertaId                    String
  huerta                      Huerta           @relation(fields: [huertaId], references: [id])
  recursoTipo                 RecursoTipo
  equipoId                    String?
  equipo                      Equipo?          @relation(fields: [equipoId], references: [id])
  fechaInicio                 DateTime         @db.Date
  fechaFin                    DateTime         @db.Date
  hectareasTotalesProgramadas Decimal          @db.Decimal(10, 4)
  estado                      EstadoAplicacion @default(programada)
  creadoPorId                 String
  fechaCreacion               DateTime         @default(now())
  canceladaPorId              String?
  fechaCancelacion            DateTime?
  confirmacionBodegaPorId     String?
  fechaConfirmacionBodega     DateTime?

  productos  FertilizacionGranularProducto[]
  cuadros    FertilizacionGranularCuadro[]
  realizadas FertilizacionGranularRealizada[]
}

// Varios productos en la misma fertilización granular (10-ago-2026, 9.5):
// se pueden revolver varios productos en polvo antes de esparcir. A
// diferencia de Aplicaciones, aquí no hay "litros de mezcla" compartido —
// cada producto conserva su propia dosis (kg/ha o g/planta), calculada de
// forma completamente independiente.
model FertilizacionGranularProducto {
  id                     String                @id @default(uuid())
  fertilizacionId        String
  fertilizacion          FertilizacionGranular @relation(fields: [fertilizacionId], references: [id])
  productoId             String
  producto               Producto              @relation(fields: [productoId], references: [id])
  modoDosis              ModoDosisGranular
  dosisValor             Decimal               @db.Decimal(10, 4)
  cantidadTotalCalculada Decimal               @db.Decimal(12, 4)

  @@index([fertilizacionId])
  @@index([productoId])
}

model FertilizacionGranularCuadro {
  fertilizacionId String
  fertilizacion   FertilizacionGranular @relation(fields: [fertilizacionId], references: [id])
  cuadroId        String
  cuadro          Cuadro                @relation(fields: [cuadroId], references: [id])

  @@id([fertilizacionId, cuadroId])
}

model FertilizacionGranularRealizada {
  id              String                @id @default(uuid())
  fertilizacionId String
  fertilizacion   FertilizacionGranular @relation(fields: [fertilizacionId], references: [id])
  personalId      String?
  grupoId         String?
  horas           Decimal               @db.Decimal(6, 2)
  fechaReal       DateTime              @db.Date
  registradoPorId String

  cuadros FertilizacionGranularRealizadaCuadro[]

  @@index([fertilizacionId])
}

model FertilizacionGranularRealizadaCuadro {
  id          String                         @id @default(uuid())
  realizadaId String
  realizada   FertilizacionGranularRealizada @relation(fields: [realizadaId], references: [id])
  cuadroId    String
  cuadro      Cuadro                         @relation(fields: [cuadroId], references: [id])
  hectareas   Decimal                        @db.Decimal(10, 4)

  @@index([realizadaId])
  @@index([cuadroId])
}

enum FrecuenciaFertirriego {
  diario
  cada_2_dias
  cada_3_dias
  patron_2_1
}

// Se programa aquí (por Sección de Riego, no por Cuadro); se ejecuta día a
// día desde Riego (9.6). No genera mano de obra.
model FertirriegoProgramacion {
  id              String                @id @default(uuid())
  huertaId        String
  huerta          Huerta                @relation(fields: [huertaId], references: [id])
  // Litros de agua/ha compartidos por todos los productos (10-ago-2026,
  // varios productos en el mismo fertirriego, mismo mecanismo que
  // Aplicaciones) — cada producto conserva su propia concentración.
  litrosAguaPorHa Decimal               @db.Decimal(10, 4)
  // Recetario (20-ago-2026): mismo mecanismo de trazabilidad que
  // Aplicacion — ver ahí el detalle del comentario.
  recetaId        String?
  receta          Receta?               @relation(fields: [recetaId], references: [id])
  capacidadTanque Decimal?              @db.Decimal(10, 2)
  frecuencia      FrecuenciaFertirriego
  fechaInicio     DateTime              @db.Date
  fechaFin        DateTime              @db.Date
  estado          EstadoAplicacion      @default(programada)
  creadoPorId     String
  fechaCreacion   DateTime              @default(now())

  productos FertirriegoProgramacionProducto[]
  secciones FertirriegoSeccion[]
}

// Varios productos en el mismo fertirriego (10-ago-2026, 9.5): mismo
// mecanismo que Aplicaciones — cada producto tiene su propia concentración,
// todos comparten los mismos litros de agua/ha (en FertirriegoProgramacion).
model FertirriegoProgramacionProducto {
  id                     String                  @id @default(uuid())
  fertirriegoId          String
  fertirriego            FertirriegoProgramacion @relation(fields: [fertirriegoId], references: [id])
  productoId             String
  producto               Producto                @relation(fields: [productoId], references: [id])
  dosisValor             Decimal                 @db.Decimal(10, 4)
  dosisUnidad            ConcentracionUnidad
  cantidadTotalCalculada Decimal                 @db.Decimal(12, 4)

  @@index([fertirriegoId])
  @@index([productoId])
}

model FertirriegoSeccion {
  fertirriegoId String
  fertirriego   FertirriegoProgramacion @relation(fields: [fertirriegoId], references: [id])
  seccionId     String
  seccion       SeccionRiego            @relation(fields: [seccionId], references: [id])

  @@id([fertirriegoId, seccionId])
}

// LOTE=Huerta, SECTOR=Variedad (equivalencia de terminología del laboratorio).
model AnalisisLaboratorio {
  id         String   @id @default(uuid())
  huertaId   String
  huerta     Huerta   @relation(fields: [huertaId], references: [id])
  variedad   String
  tipo       String // pasta_saturada | foliar | savia_cardis
  fecha      DateTime @db.Date
  resultados Json

  @@index([huertaId, variedad, fecha])
}

// ============================================================
// RIEGO — ejecución diaria (9.6)
// ============================================================

// Por Sección de Riego, por día: horas regadas + confirmación de fertirriego
// (si hay uno programado y ya entregado). No genera mano de obra (Regador es rol fijo).
model RiegoRegistroDiario {
  id                    String       @id @default(uuid())
  seccionId             String
  seccion               SeccionRiego @relation(fields: [seccionId], references: [id])
  fecha                 DateTime     @db.Date
  horas                 Decimal      @db.Decimal(6, 2)
  // "¿Se metió?" es una sola confirmación por día para toda la mezcla (se
  // inyecta junta, es un solo evento físico) — el motivo también es uno
  // solo. La cantidad sí es individual por producto (10-ago-2026, varios
  // productos en el mismo fertirriego): cada uno puede leerse en su propio
  // medidor/inyector, ver RiegoRegistroDiarioProducto.
  fertirriegoConfirmado Boolean      @default(false)
  motivoNoAplicado      String? // obligatorio si había fertirriego programado/entregado ese día y no se metió (9.6)
  capturadoPorId        String

  productos RiegoRegistroDiarioProducto[]

  @@unique([seccionId, fecha])
}

// Cantidad aplicada ese día, por producto (10-ago-2026, varios productos en
// el mismo fertirriego) — cada uno descuenta su propio Almacén Local.
model RiegoRegistroDiarioProducto {
  id               String              @id @default(uuid())
  registroId       String
  registro         RiegoRegistroDiario @relation(fields: [registroId], references: [id])
  productoId       String
  producto         Producto            @relation(fields: [productoId], references: [id])
  cantidadAplicada Decimal             @db.Decimal(12, 4)

  @@unique([registroId, productoId])
}
